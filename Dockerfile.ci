FROM python:3.11-slim

# Set env vars to avoid interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies
# git: required by PlatformIO for some libraries
# curl: useful utility
# gcc/g++: required for native environment (unit tests)
RUN apt-get update && \
    apt-get install -y --no-install-recommends git curl gcc g++ && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Install PlatformIO
RUN pip install --no-cache-dir -U platformio

# Create a directory for caching platformio packages
WORKDIR /tmp_build

# Copy configuration files to trigger dependency installation
COPY platformio.ini .
COPY scripts/ ./scripts/

# Install all dependencies: platforms, toolchains, and libraries (incl. transitive)
# pio pkg install reads lib_deps from platformio.ini directly — no source files needed
RUN pio pkg install -e esp32-s3-devkitm-1 && \
    pio pkg install -e native

# Clean up temp build dir and download cache, keep ~/.platformio packages
RUN rm -rf /tmp_build /root/.platformio/.cache

# Set the working directory for the actual project
WORKDIR /workspace

CMD ["/bin/bash"]
